DATABASE_URL="postgresql://verblayer:verblayer@localhost:55432/verblayer"
APP_BASE_URL="http://localhost:3100"
AUTH_MODE="dev"
DEV_AUTH_ENABLED="true"
# Production: set AUTH_MODE="trusted_proxy", DEV_AUTH_ENABLED="false", and a 32+ character secret.
# TRUSTED_AUTH_PROXY_SECRET="replace-with-a-long-random-proxy-secret"
INTERNAL_EXECUTION_TOKEN="replace-with-a-long-random-token-before-exposing-the-controlled-target"
# Zendesk apps store only these variable names in PostgreSQL; keep values server-side.
# ZENDESK_API_TOKEN=""
# ZENDESK_AGENT_EMAIL=""
# Salesforce apps store only the access-token environment-variable name and API version in PostgreSQL.
# SALESFORCE_ACCESS_TOKEN=""
# Callable emails verified agent command inventories through Resend when both values are configured.
# RESEND_API_KEY=""
# CALLABLE_EMAIL_FROM="Callable <notifications@example.com>"
DISCOVERY_PROVIDER="openai"
OPENAI_MODEL="gpt-4.1-mini"
# OPENAI_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-latest"
# ANTHROPIC_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"
# OPENROUTER_API_KEY=""
API_KEY_ALLOWED_ORIGINS="http://localhost:3100"
API_RATE_LIMIT_PER_MINUTE="120"
